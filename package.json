    "jszip": "^3.10.1",
    "langchain": "^0.3.7",
    "sql.js": "^1.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.5",
