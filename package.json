  },
  "bugs": {
    "url": "https://github.com/eliasbiondo/hermes/issues"
  },
  "keywords": [
    "anki",
    "flashcards",
    "browser-extension",
    "vocabulary",
    "language-learning",
    "manifest-v3",
    "chrome-extension"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
